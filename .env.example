# Flask
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true

# Secure File App database
DATABASE_URL=mysql+pymysql://secure_file_user:change-me@127.0.0.1:3306/secure_file
FILE_STORAGE_PATH=storage/files
MAX_CONTENT_LENGTH=52428800

# Secure Key Lifecycle Manager / KMS
SKLM_BASE_URL=http://127.0.0.1:8000
SKLM_USERNAME=file-service
SKLM_PASSWORD=change-me
SKLM_KEK_ID=KEY-REPLACE-ME
SKLM_VERIFY_TLS=false
SKLM_CONNECT_TIMEOUT=3
SKLM_READ_TIMEOUT=10
